# Copy to `.env.local` for local overrides. Vite only exposes vars prefixed with VITE_.
# Unset, the app talks to http://localhost:8000/api (see src/lib/apiConfig.ts).

VITE_API_BASE_URL=http://localhost:8000/api

# Clerk publishable key, the same one the SomedayTundra dashboard uses (pk_test_... for development,
# pk_live_... for production). It's safe to ship in the client bundle; the secret key (sk_...) must
# never go in this app. Unset, the app runs signed out and the sign-in card says Clerk isn't set up.
VITE_CLERK_PUBLISHABLE_KEY=
